      "source_tail": "          jac[rows, 2 * ib] = signs * (c[:, 1] - a[:, 1])\n            jac[rows, 2 * ib + 1] = signs * (a[:, 0] - c[:, 0])\n            jac[rows, 2 * ic] = signs * (a[:, 1] - b[:, 1])\n            jac[rows, 2 * ic + 1] = signs * (b[:, 0] - a[:, 0])\n            jac[:, -1] = -1.0\n            return jac\n\n        def callback(z):\n            consider(z[:22].reshape(11, 2))\n            guard()\n\n        result = minimize(\n            objective,\n            z0,\n            jac=lambda z: objective_jac,\n            method=\"SLSQP\",\n            bounds=[(0.0, 1.0)] * 22 + [(0.0, 1.0)],\n            constraints=[\n                {\"type\": \"ineq\", \"fun\": boundary,\n                 \"jac\": lambda z: boundary_jac},\n                {\"type\": \"ineq\", \"fun\": areas, \"jac\": areas_jac},\n            ],\n            callback=callback,\n            options={\"maxiter\": maxiter, \"ftol\": 2e-10, \"disp\": False},\n        )\n        consider(result.x[:22].reshape(11, 2))\n\n    # Fixed, interleaved geometric portfolio; the deadline can only\n    # shorten it, rather than introducing an unbounded restart loop.\n    order = [j for pair in zip(range(8), range(8, 16)) for j in pair]\n    try:\n        for index in order:\n            polish(seeds[index], 110)\n        # A bounded local refinement portfolio around the best placement.\n        for amplitude in (0.004, 0.012, 0.025, 0.045):\n            guard()\n            trial = project(best + rng.normal(0.0, amplitude, (11, 2)))\n            consider(trial)\n            polish(trial, 100)\n    except _DeadlineReached:\n        pass\n\n    # Move an insignificant distance inward to avoid outward rounding\n    # at the exact boundary during the coordinate conversion.\n    p = (1.0 - 2e-14) * best + 2e-14 * center\n    return np.column_stack((p[:, 0] + 0.5 * p[:, 1],\n                            height * p[:, 1]))\n"
