[Unit]
Description=Run-scoped prebuilt DGM Docker capability and model relay
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=arena
UMask=0077
RuntimeDirectory=arena-dgm
RuntimeDirectoryMode=0750
ExecStart=/opt/arena/venv/bin/python -m arena.dgm_proxy --config /etc/arena/dgm-proxy.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
ReadWritePaths=/run/arena-dgm /srv/arena/releases/dgm-proxy /srv/arena/control
ReadOnlyPaths=/srv/arena/control/queue.sqlite /srv/arena/control/runs
InaccessiblePaths=-/etc/arena/provider -/etc/arena/admin-access.json -/etc/arena/agent-access.json -/etc/arena/worker.env
MemoryMax=1G
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
