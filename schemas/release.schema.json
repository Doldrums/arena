{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doldrums/arena/raw/main/schemas/release.schema.json",
  "title": "Public Arena release identity",
  "type": "object",
  "properties": {
    "schema": {
      "const": "arena.release/1"
    },
    "system": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  },
  "required": [
    "schema",
    "system",
    "version"
  ],
  "additionalProperties": false
}
