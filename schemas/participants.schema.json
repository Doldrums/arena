{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doldrums/arena/raw/main/schemas/participants.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "arena.participants/1"
    },
    "summary": {
      "type": "object",
      "properties": {
        "participant_count": {
          "type": "integer",
          "minimum": 0
        },
        "integrated_count": {
          "const": 0
        }
      },
      "required": [
        "participant_count",
        "integrated_count"
      ],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "participant.schema.json"
      }
    }
  },
  "required": [
    "schema",
    "summary",
    "participants"
  ],
  "additionalProperties": false
}
