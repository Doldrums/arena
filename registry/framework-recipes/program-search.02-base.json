          "required_files": [
            "run_base.py",
            "base/runner.py",
            "base/arms.py",
            "core/tasks.py"
          ],
          "config_files": [],
          "result_globs": [
            "results/**/*.json",
            "results/**/*.jsonl"
          ],
          "evaluation": {
            "mode": "native",
            "description": "Native BaSE live greedy arms call the task evaluator and save per-arm results and allocation trace.",
            "evidence": [
              "core/evaluator.py",
              "tasks/circle_packing/evaluator.py"
            ]
          },
          "argument_help": [
            "Required: --model MODEL --T ROUNDS --N CHILDREN",
            "Optional: --n-arms N --bandit-seed N; model names are those in core/models.py."
          ],
          "limitations": [
            "Native FLOP estimates and API call counts are retained as reported; Arena does not convert them into verified spend."
          ]
        },
        {
          "id": "gateway-cpu-pilot",
          "description": "Small native CPU pilot through the private OpenAI-compatible gateway; exact API model identity.",
          "invocation": {
            "kind": "driver",
            "target": "arena.frameworks.drivers.base_gateway"
          },
          "cwd": ".",
          "fixed_args": [],
          "output": {
            "flag": "--output",
            "path": "results"
          },
          "required_files": [
            "run_base.py",
            "base/runner.py",
            "base/arms.py",
            "core/tasks.py",
            "base/policies.py",
            "core/models.py",
            "core/llm.py",
            "core/greedy.py",
            "core/flops.py"
          ],
          "config_files": [],
          "result_globs": [
            "results/**/*.json",
            "results/**/*.jsonl"
          ],
          "evaluation": {
            "mode": "native",
            "description": "Native BaSE live greedy arms call the task evaluator and save per-arm results and allocation trace.",
            "evidence": [
              "core/evaluator.py",
              "tasks/circle_packing/evaluator.py"
            ]
          },
          "argument_help": [
            "--model exact gateway model ID; --rounds 1..8 (one child per round, two native arms)."
          ],
          "limitations": [
            "Native FLOP estimates and API call counts are retained as reported; Arena does not convert them into verified spend.",
            "Opaque API parameter counts and all FLOPs are explicitly null. Native UCB allocations and candidate scores are unchanged. Sampling seed is recorded but not provider-enforced; temperature/top_p/token limits follow gateway codex-native policy. Native retries can exceed nominal proposal calls."
          ],
          "environment": {
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "NUMEXPR_NUM_THREADS": "1",
            "PYTHONDONTWRITEBYTECODE": "1"
          }
        }
      ]
