      "profiles": [
        {
          "id": "penguins-mcts-pilot",
          "description": "Native two-iteration MCTS prompt search on bundled penguins with disjoint reward and frozen heldout splits.",
          "invocation": {
            "kind": "driver",
            "target": "arena.frameworks.drivers.promptagent_penguins_gateway"
