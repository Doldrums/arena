          "cwd": ".",
          "fixed_args": [
            "--preparation",
            "arena-inputs/promptagent-preparation.json",
            "--dependencies",
            "arena-inputs/promptagent-dependencies.txt"
          ],
          "output": {
            "flag": "--output",
            "path": "promptagent-pilot"
          },
          "required_files": [
            "src/prompt_optim_agent/search_algo/mcts.py",
            "src/prompt_optim_agent/language_model/openai_model.py",
            "datasets/penguins_in_a_table.json"
          ],
          "config_files": [],
          "result_globs": [
            "promptagent-pilot/**/*.json",
            "promptagent-pilot/**/*.log"
          ],
          "evaluation": {
            "mode": "native",
            "description": "Unchanged BIG-bench option parsing/exact accuracy on native seeded 8 train / 4 reward / 4 heldout; native MCTS rewards choose paths/nodes before post-search heldout evaluation.",
            "evidence": [
              "src/tasks/bigbench.py",
              "src/tasks/base_task.py",
              "src/prompt_optim_agent/world_model/world_model.py",
              "src/prompt_optim_agent/search_algo/mcts.py",
              "datasets/penguins_in_a_table.json"
            ]
          },
          "argument_help": [
            "--model EXACT_REVIEWED_ID; two hashed preparation inputs required.",
            "Two MCTS iterations, width 2 / depth 2, training batch 2, requested one prompt per expansion; all native model roles share the exact alias."
          ],
          "limitations": [
            "Provider-only source ports: change OpenAI constructor import and disable unused unconditional provider imports. Hashes recorded; native MCTS/UCB/gradient prompts/parser/reward/evaluator unchanged.",
            "Native infinite API retry loop is bounded to2 attempts per logical call and96 total SDK admissions, SDK retries 0, request 330 seconds, outer 2400 seconds. Errors are sanitized before native backoff logging.",
            "Native benchmark has 149 bundled examples; tiny 16-example disjoint subset is integration evidence, not paper reproduction or canonical Arena evaluation.",
            "Heldout evaluates native reward-selected paths only after optimization. Observer hashes frozen prompt/reward/search state; test scores must not be used for further selection.",
            "Native temperatures 0/1 are recorded but unenforced by current gateway. Request bounds are not token or monetary budgets.",
            "Only CPU/OpenAI native dependency path installed; unused vLLM/HF/PaLM/CT providers are unavailable in this profile."
          ],
          "environment": {
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "NUMEXPR_NUM_THREADS": "1",
            "PYTHONUNBUFFERED": "1",
            "PYTHONDONTWRITEBYTECODE": "1"
          },
