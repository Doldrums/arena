      "profiles": [
        {
          "id": "hourly-portfolio-pilot",
          "description": "Native AEL-Full portfolio loop on four cached hourly trading days, with native phase freeze and exact gateway model.",
          "invocation": {
            "kind": "driver",
            "target": "arena.frameworks.drivers.ael_portfolio_gateway"
          },
          "cwd": ".",
          "fixed_args": [
            "--preparation",
            "arena-inputs/ael-preparation.json",
            "--dependencies",
            "arena-inputs/ael-dependencies.txt"
          ],
          "output": {
            "flag": "--output",
            "path": "ael-pilot"
          },
          "required_files": [
            "ael/llm_utils.py",
            "ael/benchmarks/portfolio_runner.py",
            "experiments/configs/ael_full.yaml"
          ],
          "config_files": [],
          "result_globs": [
            "ael-pilot/**/*.json",
            "ael-pilot/**/*.jsonl"
          ],
          "evaluation": {
            "mode": "native",
            "description": "Native PortfolioRunner uses bundled hourly returns, portfolio accounting and native return/Sharpe/drawdown metrics; 8 train, 4 validation, 4 test bars with native frozen learning on test. Static financial inputs include post-period statements, so this is not a clean historical heldout evaluation.",
            "evidence": [
              "ael/benchmarks/portfolio_runner.py",
              "ael/benchmarks/portfolio.py",
              "ael/benchmarks/finance.py",
              "ael/evolution/loop.py"
            ]
          },
          "argument_help": [
            "--model EXACT_REVIEWED_ID; both hashed arena-inputs files are mandatory.",
            "Fixed 16 hourly bars, four trading days, two tickers; no arbitrary data, endpoint or model fallback."
          ],
          "limitations": [
            "The reviewed central llm_utils provider helper is replaced in the isolated clone; all native search, parsing, bandits, credit, memory and portfolio evaluator code is unchanged. Port before/after hashes and full config are recorded.",
            "AEL-Full config enables planner/tool/memory evolution. Native portfolio mode runs all tools and injects planner guidance; it does not exercise every method branch or match the full paper protocol.",
            "Native parse failures retain upstream equal-weight fallback. Transport errors and 64-request exhaustion escape fallback and stop; no success score is claimed on incomplete integration.",
            "One native evaluator and serialized SDK requests; SDK retries0/330 seconds, outer template2400 seconds. These bounds are not a monetary budget or hostile-code security sandbox.",
            "Bundled AAPL statements include September/December2025 dates, after the January2025 pilot; native tools use static snapshots without as-of filtering. Known lookahead means metrics are integration outputs, not historical predictive-performance evidence or canonical Arena evaluations.",
            "Generation controls temperature/max_tokens are recorded but not enforced by the current gateway; cost unknown."
          ],
          "environment": {
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "NUMEXPR_NUM_THREADS": "1",
            "PYTHONUNBUFFERED": "1",
            "PYTHONDONTWRITEBYTECODE": "1",
            "AEL_DATA_DIR": "{workspace}/data"
          }
        }
      ]
    }
