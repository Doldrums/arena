{
  "schema": "arena.framework-recipes/1",
  "recipes": [
    {
      "id": "funsearch-re-implementation",
      "name": "FunSearch re-implementation",
      "participant_ids": [
        "funsearch-re-implementation"
      ],
      "repository": {
        "url": "https://github.com/kitft/funsearch",
        "commit": "cec37d84b474ea6bbd66f6defad8f5b5758449ff"
      },
      "status": "source_verified",
      "license": "Apache-2.0",
      "setup": [
        "Install the pinned Python project and prepare its chosen native sandbox dependencies; Docker is needed for Docker sandbox profiles."
      ],
      "blocked_reason": null,
      "evidence": {
        "LICENSE": "8c6db340475136df3c1201d458fa5755698eace76e510471ecc9d857d6083dac",
