      "profiles": [
        {
          "id": "poetry-mapelites-pilot",
          "description": "Native QDAIF poetry MAP-Elites: packaged seed, quality judgment and categorical diversity judgment, exact gateway model.",
          "invocation": {
            "kind": "driver",
            "target": "arena.frameworks.drivers.qdaif_poetry_gateway"
          },
          "cwd": ".",
          "fixed_args": [
            "--preparation",
            "arena-inputs/qdaif-preparation.json",
            "--dependencies",
            "arena-inputs/qdaif-dependencies.txt",
            "--constraints",
            "arena-inputs/qdaif-constraints.txt"
          ],
          "output": {
            "flag": "--output",
            "path": "qdaif-pilot"
          },
          "required_files": [
            "src/openelm/mutation_model.py",
            "src/openelm/environments/poetry.py",
            "src/openelm/algorithms/map_elites.py"
          ],
          "config_files": [],
          "result_globs": [
            "qdaif-pilot/**/*.json"
          ],
          "evaluation": {
            "mode": "native",
            "description": "Unchanged PoetryGenotype quality JSON and genre/tone JSON judgments populate native 5\u00d75 MAP-Elites archive. Self-judged quality/diversity, not canonical task fitness.",
            "evidence": [
              "src/openelm/environments/poetry.py",
              "src/openelm/algorithms/map_elites.py",
              "src/openelm/configs.py"
            ]
          },
          "argument_help": [
            "--model EXACT_REVIEWED_ID; three hash-bound arena-inputs files required.",
            "Four native iterations, batch2, initial iteration1; 8 poems and 16 native judgments."
          ],
          "limitations": [
            "Only get_model factory is replaced in the isolated clone, with before/after hashes. Native algorithm, evaluator, archive, packaged seed and prompts are unchanged.",
            "Exact same model generates and judges; old prefix-based ChatOpenAI/OpenAI selection is replaced by a dual text/messages callable. No embeddings, logprobs or local weights.",
            "24 physical HTTP attempts including legacy SDK warmup retries; no HTTP adapter retries. Serialized requests/evaluations, request timeout330s, outer2400s. Not a monetary budget.",
            "Malformed judgments keep native behavior; quality is not clamped and unknown genre/tone can fail the native search.",
            "Native generation controls temperature/top_p/max_tokens are recorded but not enforced by current gateway. Native pickle files remain opaque; JSON exports live state only.",
            "Offline SDK fixtures validate protocol, not live provider readiness or paper reproduction."
          ],
          "environment": {
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "NUMEXPR_NUM_THREADS": "1",
            "PYTHONUNBUFFERED": "1",
            "PYTHONDONTWRITEBYTECODE": "1",
            "MPLBACKEND": "Agg",
            "HF_HUB_OFFLINE": "1",
            "TRANSFORMERS_OFFLINE": "1",
            "WANDB_MODE": "disabled"
          },
          "python_paths": [
            "src"
          ]
        }
      ]
    }
  ]
}
