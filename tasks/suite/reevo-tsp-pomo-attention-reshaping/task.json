  "science_relevance": {
    "status": "supported",
    "scientific_problem": "Minimize the length of a tour that visits each location once and returns to its start.",
    "importance_rationale": "Shorter feasible tours address routing, inspection and manufacturing movement costs. The local instances are bounded algorithmic studies of that operations-research objective, not evidence of a deployed logistics improvement.",
    "papers": [
      {
        "title": "An effective implementation of the Lin–Kernighan traveling salesman heuristic",
        "url": "https://doi.org/10.1016/S0377-2217(99)00284-2",
        "task_relation": "Helsgaun develops a solver whose central goal is shorter symmetric TSP tours. TSP POMO attention reshaping uses its own construction, search, or attention interface and instance distribution while optimizing that same feasible-tour objective.",
        "primary_goal": "Compute optimal or near-optimal traveling-salesman tours efficiently.",
        "evidence_role": "primary_problem"
      }
