{
  "name": "research-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev:cloudflare": "wrangler dev api/src/dev.ts --local --ip 127.0.0.1 --port 8788",
    "typecheck": "tsc --noEmit",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:web": "npm --prefix tests/web test",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist/worker"
  },
  "dependencies": {"jose": "6.2.12"},
  "devDependencies": {"typescript": "7.0.2", "wrangler": "4.135.0", "tsx": "4.20.6", "@types/node": "22.19.3"}
}
