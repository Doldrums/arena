# Approved top-level project surface. New roots require an explicit review.
/*
!/.gitignore
!/.github/
!/README.md
!/CONTRIBUTING.md
!/pyproject.toml
!/package.json
!/package-lock.json
!/uv.lock
!/tsconfig.json
!/wrangler.jsonc
!/wrangler.debug.jsonc
!/src/
!/api/
!/web/
!/registry/
!/schemas/
!/scripts/
!/examples/
!/tests/
!/tasks/

# Documentation is maintained in exactly two root files.
*.md
!/README.md
!/CONTRIBUTING.md
docs/
reports/
notes/
scratch/

# Dependencies, build products and caches.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.wrangler/
dist/
build/
htmlcov/
.coverage*
playwright-report/
test-results/

# Credentials and per-machine configuration.
.env
.env.*
!.env.example
.dev.vars*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ecdsa
id_ed25519
credentials.json
auth.json
secrets.json

# Run artifacts stay outside the source checkout.
outputs/
autoresearch/
*.log
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.jsonl
!tests/**/fixtures/**/*.jsonl

# Editor and OS files.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

