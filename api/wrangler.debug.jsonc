{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "research-arena-debug",
  "account_id": "51d4afa0d3a5b6f5aa2c8bea66438651",
  "main": "src/debug.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    // Set an absolute Unix timestamp in SECONDS for the short, approved debug window.
    // This intentionally expired default fails closed until explicitly configured.
    "DEBUG_ACCESS_EXPIRES_AT": "1000000000"
  },
  // DEBUG_ACCESS_CODE_HASH and DEBUG_SESSION_SECRET are secret bindings, never vars.
  "ratelimits": [{
    "name": "DEBUG_LOGIN_RATE_LIMITER",
    "namespace_id": "2026092101",
    "simple": {"limit": 10, "period": 60}
  }],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
